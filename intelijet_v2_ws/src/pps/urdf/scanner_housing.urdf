<?xml version="1.0"?>
<robot name="scanner">

  <!-- Base link -->
  <link name="base_link"/>

  <!-- Scanner joint -->
  <joint name="scanner_deploy_retract" type="revolute">
    <parent link="base_link"/>
    <child link="scanner_mount"/>
    <origin xyz="0 0 0.75" rpy="0 -1.780236 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" lower="-3.0" upper="0.5" velocity="1.0"/>
  </joint>

  <!-- Scanner mount: box dài 0.2m theo trục X, tâm box tại x=0.1 (giữa cánh tay) -->
  <link name="scanner_mount">
    <visual>
      <origin xyz="0.1 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.01 0.01"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
  </link>

  <!-- LMS-511 gắn tại đầu cánh tay: x=0.2 so với trục quay -->
  <joint name="scanner_to_mount" type="fixed">
    <parent link="scanner_mount"/>
    <child link="LMS-511"/>
    <origin xyz="0.276 0 0" rpy="0 0 0"/>
  </joint>

  <!-- LMS-511: kích thước thực tế datasheet SICK (m) -->
  <link name="LMS-511">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- <box size="0.105 0.156 0.210"/> -->
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
  </link>

  <!-- Scan plane: tâm laser = tâm LMS-511, không offset thêm -->
  <joint name="scan_to_scanner" type="fixed">
    <parent link="LMS-511"/>
    <child link="LMS_511_scan_plane"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="LMS_511_scan_plane"/>

</robot>