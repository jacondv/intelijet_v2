# ===== Goal =====
#do_pre_process is TunnelProcessing->run_processing_pipeline(remove_ground=...) - tightens
#  the ground (Z) crop bound. Independent from do_remove_back_wall - either can be on/off
#  regardless of the other; the pipeline stage itself runs if either is true.
#do_remove_back_wall is TunnelProcessing->run_processing_pipeline(remove_back_wall=...) -
#  tightens the back-wall (X) crop bound. Independent from do_pre_process (see above).
#do_2d_keypoint is Extract cloud using 2D keypoint
#do_align is align prescan and postscan cloud
#do_post_process is Trim the edges around after aligning.
#Last step is compare 2 cloud

string prescan_path
string postscan_path
bool do_pre_process
bool do_remove_back_wall
bool do_2d_keypoint
bool do_align
bool do_post_process

---
# ===== Result =====
bool success
string job_id

---
# ===== Feedback =====
float32 progress
string stage
