}

QTabBar::tab {
    height: 110px;     
    width: 30px;
    margin: 0;
    color: #ddd;

    border: none;
    font-weight: normal;
    padding-top: 30px;
    padding-left: 10px;
    padding-right: 8px;
    min-height: 150px;
    max-height: 200px;

}

QTabBar::tab:selected {
    font-size: 25x;
    font-weight: bold;
    color: #ee0;
    border-left: 4px solid #FFEB3B;

}

QWidget#widget_6 QPushButton {
