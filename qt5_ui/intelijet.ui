  <property name="styleSheet">
   <string notr="true">*{
border: none;
color: back;
font-size: 15px;
}

#centralwidget {
	background-color: black;
}

#centralFrame {
    background-color: #153E42;
	border-radius: 30px;
}

#control_panel{
    /*background-color: #00796B;*/

	
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0.3 #153E42, stop:1 #153E42);
    border-left: 8px solid #F8D40F;     /* viền trái */

	border-top-right-radius: 25px;
	border-top-left-radius: 0px;
	border-bottom-right-radius: 25px;
	border-bottom-left-radius: 0px;

}

/* Định dạng cho tất cả QPushButton bên trong control_panel */
#control_panel QPushButton {
    color: #153E42;
    border: none;
    padding: 36px;
	
    font-size: 17px;
    font-weight: normal;
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #F8D40F, stop:1 #FFF9C4);

	border-top-right-radius: 35px;
	border-top-left-radius: 0px;
	border-bottom-right-radius: 35px;
	border-bottom-left-radius: 0px;

	border-left: 8px solid #55ff00;  /*#F8D40F;*/
}

/* Hiệu ứng hover / nhấn */
#control_panel QPushButton:hover {
    font-size: 17px;
	color: #212121;
    font-weight: bold;

}

#control_panel QPushButton:pressed {
    background-color: #FBC02D;
}

#control_panel QPushButton:disabled {
    background-color: #95a5a6;
    color: #dcdcdc;
}

#toolBox:tab {
	color:white;
	border-bottom: 1px solid white;
}

#toolBox QWidget{
    background-color: #153E42;
}

#menu_small {

}

#menu_main QPushButton {
    /*border-right: 1px solid #FFEB3B;     /* viền trái */

    color: white;
    font-size: 15px;
    font-weight: normal;


}


#menu_main QPushButton:hover {
    /*border-right: 1px solid #FFEB3B;     /* viền trái */

    color: white;
    font-size: 16px;
    font-weight: bold;


}



QTabBar::tab {
    height: 110px;     
    width: 20px;
    margin: 0;

    border: none;
	font-weight: normal;
	padding-top: 30px;
	padding-left: 10px;
	min-height: 100px;

}

QTabBar::tab:selected {
    font-size: 15px;
	font-weight: bold;
	color: #fff;
	border-left: 4px solid #FFEB3B;

}









