/* ==================== PUSHBUTTON ==================== */

QPushButton {
    background-color: #5C87C9;     /* xanh sáng hơn */
    color: white;
    border: 0px solid #3c6382;
    border-radius: 15px;
    padding: 6px 10px;
    font-size: 15pt;
}

QPushButton:hover {
    background-color: #3c6382;
}

QPushButton:pressed {
    background-color: #3c6382;
    border: 1px solid #355A8A;
}


/* --- Text editor (QLineEdit &amp; QTextEdit) --- */

/* Text box chung */
QLineEdit, QTextEdit {
    background-color: #FFFFFF;        /* nền trắng */
    color: #2F4F6E;                  /* chữ xanh đậm */
    border: 1px solid #B0C4DE;       /* viền nhẹ */
    padding: 4px 8px;                /* khoảng cách chữ và viền */
    font-size: 18pt;
    font-weight: bold;
}

/* Khi focus */
QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #5C87C9;       /* viền xanh khi focus */
    background-color: #F9FBFF;        /* nền sáng hơn khi focus */
}

/* Khi hover (chuột vào) */
QLineEdit:hover, QTextEdit:hover {
    border: 1px solid #74A9D8;       /* viền hover nhẹ */
}


/* --- Checkbox chung --- */
QCheckBox {
    spacing: 8px;             /* khoảng cách giữa ô và text */
    color: #2F4F6E;           /* chữ giống TextEdit */
    font-size: 18pt;
    font-weight: bold;
}

/* --- Indicator (ô vuông) --- */
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #B0C4DE; /* viền nhẹ như TextEdit */
    border-radius: 4px;         /* bo góc nhẹ */
    background: #FFFFFF;        /* nền trắng */
    margin: 0;
}

/* Hover: viền xanh nhạt */
QCheckBox::indicator:hover {
    border: 1px solid #74A9D8; /* giống hover TextEdit */
}

/* Focus: viền xanh đậm, nền sáng */
QCheckBox::indicator:focus {
    border: 1px solid #5C87C9; /* giống focus TextEdit */
    background-color: #F9FBFF;
}

/* Checked: tick hiện mặc định, nền vẫn trắng, viền xanh đậm */
QCheckBox::indicator:checked {
    border: 1px solid #5C87C9;   /* giống focus */
    background-color: #2F4F6E;    /* nền trắng, tick hiện */
}

/* Disabled: mờ */
QCheckBox::indicator:disabled {
    border: 1px solid #D3D3D3;
    background: #F5F5F5;
    color: #A0A0A0;
}


QComboBox {
    background-color: #FFFFFF;       /* nền sáng */
    color: #2F4F6E;                 /* chữ xanh đậm */
    border: 1px solid #B0C4DE;      /* viền nhẹ */
    padding: 4px 8px;
    font-size: 18pt;
    font-weight: bold;
    selection-background-color: #D0E4F5; /* khi chọn item */
}

QComboBox:disabled {
    background-color: #e0e0e0;
    color: #888888;
    border: 1px solid #b0b0b0;
}

QComboBox::drop-down:disabled {
    background-color: #d0d0d0;
}

QComboBox::down-arrow:disabled {
    image: none;
}

/* Drop-down list */
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #2F4F6E;
    border: 1px solid #B0C4DE;
    selection-background-color: #D0E4F5;
}
QComboBox QAbstractItemView::item {
    min-height: 60px;
    padding-top: 6px;
    padding-bottom: 6px;
}


/* Hover khi trỏ vào QComboBox */
QComboBox:hover {
    border: 1px solid #5C87C9;
}

/* Khi mở drop-down */
QComboBox:focus {
    border: 1px solid #5C87C9;
}

QGroupBox {
    border: 1px solid #B0C4DE;   /* viền nhẹ */
    background-color: #FFFFFF;    /* nền trắng */
    margin-top: 10px;
    padding: 8px;
    font-weight: bold;
    font-size: 18pt;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;                   /* khoảng cách từ viền trái */
    padding: 0 4px;
    color: #2F4F6E;              /* chữ xanh đậm */
}



/* ==================== SCROLLBAR ==================== */
QScrollBar:vertical {
    width: 30px;
    background: #f0f0f0;
    margin: 0;
    border-radius: 0px;
}
QScrollBar::handle:vertical {
    background: #b0b0b0;
    min-height: 20px;
    border-radius: 0px;
}
QScrollBar::handle:vertical:hover {
    background: #909090;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

*{
border: none;
font-size: 18pt
}
#statusbar {
    background-color: #185F63;
    
}

#centralwidget {
    background-color: black;

}

#centralFrame {
    background-color: #185F63;
    border-radius: 30px;
}

#control_panel{
    /*background-color: #00796B;*/

    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0.3 #185F63, stop:1 #185F63);
    border-left: 8px solid #F8D40F;     /* viền trái */
    border-top-right-radius: 25px;
    border-top-left-radius: 0px;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 0px;

}

/* Định dạng cho tất cả QPushButton bên trong control_panel */
#control_panel QPushButton {
    color: #153E42;
    border: none;
    padding: 40px 0px 40px 0px;
    
    font-size:18pt;
    font-weight: bold;
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #F8D40F, stop:1 #FFF9C4);

    border-top-right-radius: 40px;
    border-top-left-radius: 0px;
    border-bottom-right-radius: 40px;
    border-bottom-left-radius: 0px;

    border-left: 24px solid #95a5a6; /*#55ff00;  #F8D40F;*/
}

/* Hiệu ứng hover / nhấn */
#control_panel QPushButton:hover {
    font-size: 18pt;
    color: #00aa7f;
    padding: 36px 5px 36px 0px;

}

#control_panel QPushButton:pressed {
    background-color: #FBC02D;
}

#control_panel QPushButton:disabled {
    background-color: #95a5a6;
    color: #dcdcdc;
}

#control_panel QLabel {
    background-color: rgba(0, 0, 0, 0);
    border: none;
}

QLabel {
    background-color: #EAF2F8;   /* nền nhạt */
    color: #2F4F6E;              /* chữ xanh công nghiệp */
    border: 1px solid #B0C4DE;   /* viền nhẹ */
    padding: 4px 8px;
    font-size: 18pt;
    font-weight: bold;
}

#toolBox{
    padding-top:30px;
    color:white;
}

#toolBox:tab {
    border-bottom: 2px solid white;
    padding-left: 2px;
    padding-bottom: 2px;
}

#toolBox QWidget{
    /*background-color: #185F63;*/
    background: transparent;
    color: white;

}


#btnShutdown {
    background-color: #185F63;
    color: white;
}


