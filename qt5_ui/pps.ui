              <property name="styleSheet">
               <string notr="true">QPushButton {
    border-radius: 40px; /* bo góc */
    color: white;
    padding: 6px 12px;
    border: none;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #63cdda, stop:1 #63cdda); /* gradient xanh */
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #63cdda, stop:1 #63cdda);
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #3dc1d3, stop:1 #3dc1d3);
    padding-left: 4px;  /* tạo cảm giác nhấn sâu */
