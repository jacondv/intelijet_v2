     <property name="styleSheet">
      <string notr="true">/* Toàn bộ list widget */
QListWidget {
    background-color: #FFFFFF;      /* nền trắng */
    color: #2F4F6E;                /* chữ xanh đậm */
    border: 1px solid #B0C4DE;     /* viền nhẹ */
    font-size: 14px;
    font-weight: bold;
    padding: 2px;
}

/* Khi hover trên widget */
QListWidget:hover {
    border: 1px solid #74A9D8;
}

/* Khi focus widget */
QListWidget:focus {
    border: 1px solid #5C87C9;
    background-color: #F9FBFF;
}

/* Item trong list */
QListWidget::item {
    padding: 6px 10px;             /* khoảng cách chữ trong item */
    height: 30px;                  /* tăng chiều cao item */
}

/* Item được chọn */
QListWidget::item:selected {
    background-color: #D0E4F5;      /* màu chọn */
    color: #2F4F6E;
}

/* Item hover */
QListWidget::item:hover {
    background-color: #E4F0FA;      /* màu hover */
}
</string>
