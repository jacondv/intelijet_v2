  <property name="styleSheet">
   <string notr="true">
QPushButton {
    background-color: #5C87C9;     /* xanh sáng hơn */
    color: white;
    border: 0px solid #3c6382;
    padding: 6px 10px;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #3c6382;
}

QPushButton:pressed {
    background-color: #3c6382;
    border: 1px solid #355A8A;
}


/* --- Text editor (QLineEdit &amp; QTextEdit) --- */
/* Text box chung */
QLineEdit, QTextEdit {
    background-color: #FFFFFF;        /* nền trắng */
    color: #2F4F6E;                  /* chữ xanh đậm */
    border: 1px solid #B0C4DE;       /* viền nhẹ */
    padding: 4px 8px;                /* khoảng cách chữ và viền */
    font-size: 14px;
    font-weight: bold;
}

/* Khi focus */
QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #5C87C9;       /* viền xanh khi focus */
    background-color: #F9FBFF;        /* nền sáng hơn khi focus */
}

/* Khi hover (chuột vào) */
QLineEdit:hover, QTextEdit:hover {
    border: 1px solid #74A9D8;       /* viền hover nhẹ */
}


QComboBox {
    background-color: #FFFFFF;       /* nền sáng */
    color: #2F4F6E;                 /* chữ xanh đậm */
    border: 1px solid #B0C4DE;      /* viền nhẹ */
    padding: 4px 8px;
    font-size: 14px;
    font-weight: bold;
    selection-background-color: #D0E4F5; /* khi chọn item */
}

/* Drop-down list */
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #2F4F6E;
    border: 1px solid #B0C4DE;
    selection-background-color: #D0E4F5;
}

/* Hover khi trỏ vào QComboBox */
QComboBox:hover {
    border: 1px solid #5C87C9;
}

/* Khi mở drop-down */
QComboBox:focus {
    border: 1px solid #5C87C9;
}
QGroupBox {
    border: 1px solid #B0C4DE;   /* viền nhẹ */
    background-color: #FFFFFF;    /* nền trắng */
    margin-top: 10px;
    padding: 8px;
    font-weight: bold;
    font-size: 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;                   /* khoảng cách từ viền trái */
    padding: 0 4px;
    color: #2F4F6E;              /* chữ xanh đậm */
}



/* ==================== SCROLLBAR ==================== */
QScrollBar:vertical {
    width: 12px;
    background: #f0f0f0;
    margin: 0;
    border-radius: 0px;
}
QScrollBar::handle:vertical {
    background: #b0b0b0;
    min-height: 20px;
    border-radius: 0px;
}
QScrollBar::handle:vertical:hover {
    background: #909090;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}</string>
