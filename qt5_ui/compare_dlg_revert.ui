  <property name="styleSheet">
   <string notr="true">* {
    font-size: 18pt;
}
QPushButton {
    background-color: #5C87C9;
    color: white;
    border: 0px solid #3c6382;
    border-radius: 15px;
    padding: 6px 10px;
}
QPushButton:hover {
    background-color: #3c6382;
}
QPushButton:pressed {
    background-color: #3c6382;
    border: 1px solid #355A8A;
}
QLineEdit, QTextEdit {
    background-color: #FFFFFF;
    color: #2F4F6E;
    border: 1px solid #B0C4DE;
    padding: 4px 8px;
    font-weight: bold;
}
QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #5C87C9;
    background-color: #F9FBFF;
}
QLineEdit:hover, QTextEdit:hover {
    border: 1px solid #74A9D8;
}
QComboBox {
    background-color: #FFFFFF;
    color: #2F4F6E;
    border: 1px solid #B0C4DE;
    padding: 4px 8px;
    font-weight: bold;
    selection-background-color: #D0E4F5;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #2F4F6E;
    border: 1px solid #B0C4DE;
    selection-background-color: #D0E4F5;
}
QComboBox:hover {
    border: 1px solid #5C87C9;
}
QComboBox:focus {
    border: 1px solid #5C87C9;
}
QGroupBox {
    border: 1px solid #B0C4DE;
    background-color: #FFFFFF;
    margin-top: 10px;
    padding: 8px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #2F4F6E;
}
QCheckBox {
    spacing: 8px;
    color: #2F4F6E;
    font-weight: bold;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #B0C4DE;
    border-radius: 4px;
    background: #FFFFFF;
    margin: 0;
}
QCheckBox::indicator:hover {
    border: 1px solid #74A9D8;
}
QCheckBox::indicator:focus {
    border: 1px solid #5C87C9;
    background-color: #F9FBFF;
}
QCheckBox::indicator:checked {
    border: 1px solid #5C87C9;
    background-color: #2F4F6E;
}
QCheckBox::indicator:disabled {
    border: 1px solid #D3D3D3;
    background: #F5F5F5;
    color: #A0A0A0;
}
QLabel {
    color: #2F4F6E;
    font-weight: bold;
}
QScrollBar:vertical {
    width: 30px;
    background: #f0f0f0;
    margin: 0;
    border-radius: 0px;
}
QScrollBar::handle:vertical {
    background: #b0b0b0;
    min-height: 20px;
    border-radius: 0px;
}
QScrollBar::handle:vertical:hover {
    background: #909090;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}</string>
