   <string notr="true">
/* ==================== PUSHBUTTON ==================== */

QPushButton {
    background-color: #5C87C9;     /* xanh sáng hơn */
    color: white;
    border: 0px solid #3c6382;
    padding: 6px 10px;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #3c6382;
}

QPushButton:pressed {
    background-color: #3c6382;
    border: 1px solid #355A8A;
}


/* --- Text editor (QLineEdit &amp; QTextEdit) --- */
/* Text box chung */
QLineEdit, QTextEdit {
    background-color: #FFFFFF;        /* nền trắng */
    color: #2F4F6E;                  /* chữ xanh đậm */
    border: 1px solid #B0C4DE;       /* viền nhẹ */
    padding: 4px 8px;                /* khoảng cách chữ và viền */
    font-size: 14px;
    font-weight: bold;
}

/* Khi focus */
QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #5C87C9;       /* viền xanh khi focus */
    background-color: #F9FBFF;        /* nền sáng hơn khi focus */
}

/* Khi hover (chuột vào) */
QLineEdit:hover, QTextEdit:hover {
    border: 1px solid #74A9D8;       /* viền hover nhẹ */
}


QComboBox {
    background-color: #FFFFFF;       /* nền sáng */
    color: #2F4F6E;                 /* chữ xanh đậm */
    border: 1px solid #B0C4DE;      /* viền nhẹ */
    padding: 4px 8px;
    font-size: 14px;
    font-weight: bold;
    selection-background-color: #D0E4F5; /* khi chọn item */
}

/* Drop-down list */
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #2F4F6E;
    border: 1px solid #B0C4DE;
    selection-background-color: #D0E4F5;
}

/* Hover khi trỏ vào QComboBox */
QComboBox:hover {
    border: 1px solid #5C87C9;
}

/* Khi mở drop-down */
QComboBox:focus {
    border: 1px solid #5C87C9;
}
QGroupBox {
    border: 1px solid #B0C4DE;   /* viền nhẹ */
    background-color: #FFFFFF;    /* nền trắng */
    margin-top: 10px;
    padding: 8px;
    font-weight: bold;
    font-size: 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;                   /* khoảng cách từ viền trái */
    padding: 0 4px;
    color: #2F4F6E;              /* chữ xanh đậm */
}



/* ==================== SCROLLBAR ==================== */
QScrollBar:vertical {
    width: 12px;
    background: #f0f0f0;
    margin: 0;
    border-radius: 0px;
}
QScrollBar::handle:vertical {
    background: #b0b0b0;
    min-height: 20px;
    border-radius: 0px;
}
QScrollBar::handle:vertical:hover {
    background: #909090;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

*{
border: none;
font-size: 17px;
}
#statusbar {
    background-color: #185F63;
	
}

#centralwidget {
	background-color: black;

}

#centralFrame {
    background-color: #185F63;
	border-radius: 30px;
}

#control_panel{
    /*background-color: #00796B;*/

	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0.3 #185F63, stop:1 #185F63);
    border-left: 8px solid #F8D40F;     /* viền trái */
	border-top-right-radius: 25px;
	border-top-left-radius: 0px;
	border-bottom-right-radius: 25px;
	border-bottom-left-radius: 0px;

}

/* Định dạng cho tất cả QPushButton bên trong control_panel */
#control_panel QPushButton {
    color: #153E42;
    border: none;
    padding: 40px 0px 40px 0px;
	
    font-size:18px;
    font-weight: bold;
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #F8D40F, stop:1 #FFF9C4);

	border-top-right-radius: 40px;
	border-top-left-radius: 0px;
	border-bottom-right-radius: 40px;
	border-bottom-left-radius: 0px;

	border-left: 24px solid #95a5a6; /*#55ff00;  #F8D40F;*/
}

/* Hiệu ứng hover / nhấn */
#control_panel QPushButton:hover {
    font-size: 18px;
	color: #00aa7f;
    padding: 36px 5px 36px 0px;

}

#control_panel QPushButton:pressed {
    background-color: #FBC02D;
}

#control_panel QPushButton:disabled {
    background-color: #95a5a6;
    color: #dcdcdc;
}

QLabel {
    background-color: #EAF2F8;   /* nền nhạt */
    color: #2F4F6E;              /* chữ xanh công nghiệp */
    border: 1px solid #B0C4DE;   /* viền nhẹ */
    padding: 4px 8px;
    font-size: 14px;
    font-weight: bold;
}

#toolBox{
	padding-top:30px;
	color:white;
}

#toolBox:tab {
	border-bottom: 2px solid white;
	padding-left: 2px;
	padding-bottom: 2px;
}

#toolBox QWidget{
    /*background-color: #185F63;*/
	background: transparent;
	color: white;

}


#btnShutdown {
    background-color: #185F63;
	color: white;
}


#menu_small {

}

#menu_main QPushButton {
    /*border-right: 1px solid #FFEB3B;     /* viền trái */

    font-weight: normal;

}


#menu_main QPushButton:hover {
    /*border-right: 1px solid #FFEB3B;     /* viền trái */

    font-weight: bold;

}
#menu_main {
	color: none;
}

QTabBar::tab {
    height: 110px;     
    width: 20px;
    margin: 0;
	color: #ddd;

    border: none;
	font-weight: normal;
	padding-top: 30px;
	padding-left: 10px;
	padding-right: 8px;
	min-height: 100px;

}

QTabBar::tab:selected {
    font-size: 18px;
	font-weight: bold;
	color: #ee0;
	border-left: 4px solid #FFEB3B;

}

QWidget#widget_6 QPushButton {
    background-color: #aaa;
    color: white;
    border-radius: 0px;
    padding: 6px 12px;
}
QWidget#widget_6 QPushButton:hover {
    background-color: #2A8C91;
}


