               <property name="styleSheet">
                <string notr="true">/* Toàn bộ ComboBox */
QComboBox {
    background-color: #FFFFFF;       /* nền trắng */
    color: #2F4F6E;                  /* chữ xanh đậm */
    border: 1px solid #B0C4DE;       /* viền nhẹ */
    font-size: 14px;
    font-weight: bold;
    padding: 4px 8px;
}

/* Khi hover trên ComboBox */
QComboBox:hover {
    border: 1px solid #74A9D8;
}

/* Khi focus ComboBox */
QComboBox:focus {
    border: 1px solid #5C87C9;
    background-color: #F9FBFF;
}

/* Drop-down list (Item view) */
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #2F4F6E;
    border: 1px solid #B0C4DE;
    selection-background-color: #D0E4F5;
    font-size: 14px;
    font-weight: bold;
}

/* Tăng chiều cao item */
QComboBox QAbstractItemView::item {
    height: 30px;                     /* chiều cao item */
    padding: 6px 10px;
}

/* Khi hover item */
QComboBox QAbstractItemView::item:hover {
    background-color: #E4F0FA;
}

/* Khi chọn item */
QComboBox QAbstractItemView::item:selected {
    background-color: #D0E4F5;
    color: #2F4F6E;
}
</string>
               </property>
               <property name="editable">
                <bool>false</bool>
               </property>
